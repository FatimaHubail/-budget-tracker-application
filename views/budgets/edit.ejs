<!DOCTYPE html>
<html lang="en">

<head>
    <script defer src="/js/customSelect.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>Edit Budget Limit</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main class="form-page">

            <a href="<%= group ? `/groups/${group._id}` : '/transactions' %>" class="back-link">&larr; Back</a>

            <h1>Edit Budget Limit</h1>

            <% if (group) { %>
                <p class="form-subtitle">Editing in <strong>
                        <%= group.name %>
                    </strong></p>
                <% } %>

                    <form
                        action="<%= group ? `/groups/${group._id}/budgets/${budget._id}?_method=PUT` : `/budgets/${budget._id}?_method=PUT` %>"
                        method="post" class="transaction-form" id="budget-form">
                        <label for="category">Category</label>
                        <select id="category" name="category">
                            <option value="" <%= currentCategoryValue==='' ? 'selected' : '' %>>Overall (all
                                categories)</option>
                            <option value="food" <%= currentCategoryValue==='food' ? 'selected' : '' %>>Food</option>
                            <option value="groceries" <%= currentCategoryValue==='groceries' ? 'selected' : '' %>>
                                Groceries</option>
                            <option value="transport" <%= currentCategoryValue==='transport' ? 'selected' : '' %>>
                                Transport</option>
                            <option value="bills" <%= currentCategoryValue==='bills' ? 'selected' : '' %>>Bills
                            </option>
                            <option value="rent" <%= currentCategoryValue==='rent' ? 'selected' : '' %>>Rent</option>
                            <option value="entertainment" <%= currentCategoryValue==='entertainment' ? 'selected' : '' %>>
                                Entertainment</option>
                            <option value="shopping" <%= currentCategoryValue==='shopping' ? 'selected' : '' %>>
                                Shopping</option>
                            <option value="health" <%= currentCategoryValue==='health' ? 'selected' : '' %>>Health
                            </option>
                            <option value="education" <%= currentCategoryValue==='education' ? 'selected' : '' %>>
                                Education</option>
                            <option value="travel" <%= currentCategoryValue==='travel' ? 'selected' : '' %>>Travel
                            </option>
                            <option value="subscriptions" <%= currentCategoryValue==='subscriptions' ? 'selected' : '' %>>
                                Subscriptions</option>

                            <% customCategories.forEach(cat=> { %>
                                <option value="other:<%= cat._id %>"
                                    <%= currentCategoryValue==='other:' + cat._id ? 'selected' : '' %>>
                                    <%= cat.name.charAt(0).toUpperCase() + cat.name.slice(1) %>
                                </option>
                                <% }) %>
                        </select>

                        <label for="monthlyLimit">Monthly Limit</label>
                        <input type="number" id="monthlyLimit" name="monthlyLimit" step="0.01" min="0"
                            value="<%= budget.monthlyLimit %>" required>

                        <div class="form-actions">
                            <a href="<%= group ? `/groups/${group._id}` : '/transactions' %>"
                                class="btn-cancel">Cancel</a>
                            <button type="submit" class="btn-save">Save Budget</button>
                        </div>
                    </form>
        </main>

        <%- include('../partials/_footer.ejs') %>
</body>

</html>
