<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= group.name %></title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>

        <main class="form-page">

            <a href="/groups/<%= group._id %>" class="back-link">&larr; Back</a>

            <h1>Edit Group</h1>

            <form action="/groups/<%= group._id %>?_method=PUT" method="POST" class="group-form">

                <label for="name">Group Name</label>
                <input type="text" id="name" name="name" value="<%= group.name %>" required>

                <% if (userRole === 'admin') { %>
                    <label for="budgetLimit">Monthly Budget Limit</label>
                    <input type="number" id="budgetLimit" name="budgetLimit" step="0.001" min="0"
                        value="<%= group.budgetLimit != null ? group.budgetLimit : '' %>">
                    <% } else if (group.budgetLimit != null) { %>
                        <p class="group-meta">Monthly Budget Limit: $<%= group.budgetLimit.toFixed(2) %> (only an admin
                                can change this)</p>
                        <% } %>

                            <div class="form-actions">
                                <a href="/groups/<%= group._id %>" class="btn-cancel">Cancel</a>
                                <button type="submit" class="btn-save">Save Changes</button>
                            </div>

            </form>

        </main>

        <%- include('../partials/_footer.ejs') %>
</body>

</html>
