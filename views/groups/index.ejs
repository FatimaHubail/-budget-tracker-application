<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Groups</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>

        <main class="groups-page">

            <div class="list-header">
                <h1>My Groups</h1>
                <a href="/groups/new" class="btn-add">+ Create New Group</a>
            </div>

            <% if (groups.length===0) { %>
                <p class="empty-state">You're not part of any groups yet. Create one to start sharing a budget.</p>
                <% } else { %>
                    <section class="group-cards">
                        <% groups.forEach(group=> { %>
                            <a href="/groups/<%= group._id %>" class="card group-card">
                                <h3 class="group-name">
                                    <%= group.name %>
                                </h3>

                                <p class="group-meta">
                                    <span class="meta-label">Owner:</span>
                                    <span class="meta-value">
                                        <%= group.owner.username %>
                                    </span>
                                </p>

                                <p class="group-meta">
                                    <span class="meta-label">Members:</span>
                                    <span class="meta-value">
                                        <%= group.members.length %>
                                    </span>
                                </p>
                            </a>
                            <% }) %>
                    </section>
                    <% } %>

        </main>

        <%- include('../partials/_footer.ejs') %>
</body>

</html>