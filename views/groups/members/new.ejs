<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>Add Member - <%= group.name %>
    </title>
</head>

<body>
    <%- include('../../partials/_navbar.ejs') %>

        <main class="form-page">

            <a href="/groups/<%= group._id %>" class="back-link">&larr; Back to <%= group.name %></a>

            <h1>Add Member</h1>
            <p class="form-subtitle">Invite someone to join <strong>
                    <%= group.name %>
                </strong></p>

            <form action="/groups/<%= group._id %>/invite" method="POST" class="invite-form">

                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="name@example.com" required>

                <label for="role">Role</label>
                <select id="role" name="role" required>
                    <option value="viewer" selected>Viewer - can view only</option>
                    <option value="editor">Editor - can add transactions</option>
                    <option value="admin">Admin - full control</option>
                </select>

                <div class="form-actions">
                    <a href="/groups/<%= group._id %>" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">Send Invite</button>
                </div>

            </form>

        </main>

        <%- include('../../partials/_footer.ejs') %>
</body>

</html>