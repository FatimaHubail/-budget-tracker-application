<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>New Group</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>

        <main class="form-page">

            <a href="/groups" class="back-link">&larr; Back</a>

            <h1>New Group</h1>

            <form action="/groups" method="POST" class="group-form">

                <label for="name">Group Name</label>
                <input type="text" id="name" name="name" placeholder="e.g. Family Budget, Roommates" required>

                <div class="form-actions">
                    <a href="/groups" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">Create Group</button>
                </div>

            </form>

        </main>

        <%- include('../partials/_footer.ejs') %>
</body>

</html>