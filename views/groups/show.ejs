<!DOCTYPE html>
<html lang="en">

<head>
    <script defer src="/js/datePicker.js"></script>
    <script defer src="/js/customSelect.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        <%= group.name %>
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>

        <main class="group-detail-page">

            <a href="/groups" class="back-link">&larr; Back to Groups</a>

            <!-- ===== Group Header ===== -->
            <div class="group-header">
                <div>
                    <h1>
                        <%= group.name %>
                    </h1>
                    <p class="group-meta">Owner: <%= group.owner.username %>
                    </p>
                </div>

                <div class="group-actions">
                    <div class="group-actions-primary">
                        <a href="/groups/<%= group._id %>/summary" class="btn-secondary btn-sm">View Summary</a>

                        <!-- every member can rename the group -->
                        <a href="/groups/<%= group._id %>/edit" class="btn-secondary btn-sm">Edit Group</a>

                        <% if (userRole==='admin' ) { %>
                            <a href="/groups/<%= group._id %>/members/new" class="btn-add btn-sm">+ Add Member</a>
                            <% } %>
                    </div>

                    <div class="group-actions-danger">
                        <!-- any member, including the owner, can leave; ownership passes on automatically -->
                        <form action="/groups/<%= group._id %>/leave?_method=DELETE" method="POST"
                            onsubmit="return confirm('<%= group.owner._id.toString() === user._id ? 'Leave this group? Ownership will pass to the next member.' : 'Leave this group?' %>');">
                            <button type="submit" class="btn-outline-delete btn-sm">Leave Group</button>
                        </form>

                        <% if (userRole==='admin' ) { %>
                            <!-- only an admin can delete the group -->
                            <form action="/groups/<%= group._id %>?_method=DELETE" method="POST"
                                onsubmit="return confirm('Delete this group and all of its transactions?');">
                                <button type="submit" class="btn-delete btn-sm">Delete Group</button>
                            </form>
                            <% } %>
                    </div>
                </div>
            </div>

            <!-- ===== Currency Toggle ===== -->
            <form method="GET" action="/groups/<%= group._id %>" class="currency-toggle">
                <input type="hidden" name="category" value="<%= query.category || '' %>">
                <input type="hidden" name="type" value="<%= query.type || '' %>">
                <input type="hidden" name="month" value="<%= query.month || '' %>">
                <input type="hidden" name="search" value="<%= query.search || '' %>">
                <label for="displayCurrency">Show amounts in:</label>
                <select id="displayCurrency" name="displayCurrency" onchange="this.form.submit()">
                    <% currencies.forEach(code => { %>
                        <option value="<%= code %>" <%=displayCurrency===code ? 'selected' : '' %>><%= code %></option>
                    <% }) %>
                </select>
            </form>

            <!-- ===== Budget Status ===== -->
            <section class="budget-section">
                <div class="list-header">
                    <h2>Budget</h2>
                    <% if (userRole==='admin' ) { %>
                        <a href="/groups/<%= group._id %>/budgets/new" class="btn-add">+ Set Budget</a>
                        <% } %>
                </div>

                <% if (budgets.length===0) { %>
                    <p class="empty-state">No budget limits set yet.</p>
                    <% } else { %>
                        <ul class="budget-list">
                            <% budgets.forEach(budget=> { %>
                                <li class="budget-item <%= budget.exceeded ? 'budget-exceeded' : '' %>">
                                    <div class="budget-label">
                                        <span>
                                            <%= budget.category ? budget.category.charAt(0).toUpperCase() +
                                                budget.category.slice(1) : 'Overall' %>
                                        </span>
                                        <span>
                                            <%= budget.spent.toFixed(decimals) %> / <%= budget.limit.toFixed(decimals)
                                                    %>
                                                    <%= displayCurrency %>
                                        </span>
                                    </div>
                                    <div class="bar-track">
                                        <div class="bar-fill <%= budget.exceeded ? 'expense-fill' : 'income-fill' %>"
                                            style="width: <%= Math.min(budget.percentage, 100).toFixed(1) %>%;"></div>
                                    </div>
                                    <% if (budget.exceeded) { %>
                                        <p class="budget-warning">Exceeded by <%= (budget.spent -
                                                budget.limit).toFixed(decimals) %>
                                                <%= displayCurrency %>
                                        </p>
                                        <% } %>
                                            <% if (userRole==='admin' ) { %>
                                                <div class="budget-item-actions">
                                                    <a href="/groups/<%= group._id %>/budgets/<%= budget.id %>/edit"
                                                        class="btn-secondary btn-sm">Edit</a>
                                                    <form
                                                        action="/groups/<%= group._id %>/budgets/<%= budget.id %>?_method=DELETE"
                                                        method="POST" class="delete-form"
                                                        onsubmit="return confirm('Delete this budget limit?');">
                                                        <button type="submit"
                                                            class="btn-outline-delete btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                                <% } %>
                                </li>
                                <% }) %>
                        </ul>
                        <% } %>
            </section>

            <!-- ===== Members List ===== -->
            <section class="members-section">
                <h2>Members (<%= group.members.length %>)</h2>
                <ul class="members-list">
                    <% group.members.forEach(member=> { %>
                        <li class="member-item">
                            <span>
                                <%= member.user.username %>
                            </span>
                            <span class="member-role member-role-<%= member.role %>">
                                <%= member.role.charAt(0).toUpperCase() + member.role.slice(1) %>
                            </span>
                        </li>
                        <% }) %>
                </ul>
            </section>

            <!-- ===== Group Transactions ===== -->
            <section class="transaction-list">
                <div class="list-header">
                    <h2>Group Transactions</h2>
                    <% if (userRole==='admin' || userRole==='editor' ) { %>
                        <a href="/groups/<%= group._id %>/transactions/new" class="btn-add">+ Add Transaction</a>
                        <% } %>
                </div>

                <!-- ===== Filters + Search ===== -->
                <%- include('../partials/_filterBar.ejs', {query, action: `/groups/${group._id}`, customCategories}) %>

                    <% if (transactions.length===0) { %>
                        <p class="empty-state">
                            <% if (query.category || query.type || query.month) { %>
                                No transactions found. Try adjusting your filters.
                                <% } else { %>
                                    No transactions in this group yet.
                                    <% } %>
                        </p>
                        <% } else { %>
                            <table class="transaction-table">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Type</th>
                                        <th>Added By</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% transactions.forEach(transaction=> { %>
                                        <tr class="transaction-row">
                                            <td>
                                                <%= transaction.title %>
                                            </td>
                                            <td
                                                class="<%= transaction.type === 'income' ? 'amount-income' : 'amount-expense' %>">
                                                <%= transaction.type %>
                                            </td>
                                            <td>
                                                <%= transaction.user ? transaction.user.username : '—' %>
                                            </td>
                                            <td>
                                                <a href="/groups/<%= group._id %>/transactions/<%= transaction._id %>"
                                                    class="btn-details">
                                                    View Details
                                                </a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                            <% } %>
            </section>

        </main>

        <%- include('../partials/_footer.ejs') %>
</body>

</html>