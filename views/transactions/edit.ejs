<!DOCTYPE html>
<html lang="en">

<head>
    <script defer src="/js/categoryProcessor.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= transaction.title %> Transaction</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main class="form-page">
            <a href="/transactions/<%= transaction._id %>" class="back-link">&larr; Back</a>

            <h1>Edit Transaction</h1>

            <form action="/transactions/<%= transaction._id %>?_method=PUT" method="POST" class="transaction-form"
                id="transaction-form">

                <label for="title">Title</label>
                <input type="text" id="title" name="title" value="<%= transaction.title %>" required>

                <label for="description">Description</label>
                <textarea name="description" id="description"><%= transaction.description || '' %></textarea>

                <label for="amount">Amount</label>
                <input type="number" id="amount" name="amount" step="0.01" min="0" value="<%= transaction.amount %>"
                    required>

                <label>Type</label>
                <div class="radio-group">
                    <label>
                        <input type="radio" name="type" value="income" <%=transaction.type==='income' ? 'checked' : ''
                            %> required>
                        Income
                    </label>
                    <label>
                        <input type="radio" name="type" value="expense" <%=transaction.type==='expense' ? 'checked' : ''
                            %> required>
                        Expense
                    </label>
                </div>

                <label for="category-choice">Category</label>
                <select id="category-choice" required>
                    <option value="" disabled data-type="">Select a category</option>

                    <!-- fixed income categories -->
                    <option value="salary" data-type="income" <%=transaction.category==='salary' ? 'selected' : '' %>
                        >Salary</option>
                    <option value="freelance" data-type="income" <%=transaction.category==='freelance' ? 'selected' : ''
                        %>>Freelance</option>
                    <option value="gift" data-type="income" <%=transaction.category==='gift' ? 'selected' : '' %>>Gift
                    </option>
                    <option value="investment" data-type="income" <%=transaction.category==='investment' ? 'selected'
                        : '' %>>Investment</option>

                    <!-- fixed expense categories -->
                    <option value="food" data-type="expense" <%=transaction.category==='food' ? 'selected' : '' %>>Food
                    </option>
                    <option value="groceries" data-type="expense" <%=transaction.category==='groceries' ? 'selected'
                        : '' %>>Groceries</option>
                    <option value="transport" data-type="expense" <%=transaction.category==='transport' ? 'selected'
                        : '' %>>Transport</option>
                    <option value="bills" data-type="expense" <%=transaction.category==='bills' ? 'selected' : '' %>
                        >Bills</option>
                    <option value="rent" data-type="expense" <%=transaction.category==='rent' ? 'selected' : '' %>>Rent
                    </option>
                    <option value="entertainment" data-type="expense" <%=transaction.category==='entertainment'
                        ? 'selected' : '' %>>Entertainment</option>
                    <option value="shopping" data-type="expense" <%=transaction.category==='shopping' ? 'selected' : ''
                        %>>Shopping</option>
                    <option value="health" data-type="expense" <%=transaction.category==='health' ? 'selected' : '' %>
                        >Health</option>
                    <option value="education" data-type="expense" <%=transaction.category==='education' ? 'selected'
                        : '' %>>Education</option>
                    <option value="travel" data-type="expense" <%=transaction.category==='travel' ? 'selected' : '' %>
                        >Travel</option>
                    <option value="subscriptions" data-type="expense" <%=transaction.category==='subscriptions'
                        ? 'selected' : '' %>>Subscriptions</option>

                    <!-- custom categories already saved by this user -->
                    <% customCategories.forEach(cat=> { %>
                        <option value="<%= cat.name %>" data-type="<%= cat.type %>" data-custom="true"
                            <%=transaction.customCategory &&
                            transaction.customCategory._id.toString()===cat._id.toString() ? 'selected' : '' %>>
                            <%= cat.name.charAt(0).toUpperCase() + cat.name.slice(1) %>
                        </option>
                        <% }) %>

                            <!-- generic "other" - only selected if no matching custom category was found -->
                            <option value="other" data-type="income" <%=transaction.category==='other' &&
                                !transaction.customCategory && transaction.type==='income' ? 'selected' : '' %>>Other
                                (new)</option>
                            <option value="other" data-type="expense" <%=transaction.category==='other' &&
                                !transaction.customCategory && transaction.type==='expense' ? 'selected' : '' %>>Other
                                (new)</option>
                </select>

                <!-- hidden fields actually submitted to the server -->
                <input type="hidden" id="category" name="category" value="<%= transaction.category %>">

                <div id="new-category-wrapper" style="display: none;">
                    <label for="newCategory">New Category Name</label>
                    <input type="text" id="newCategory" name="newCategory" placeholder="Enter new category">
                </div>

                <label for="date">Date</label>
                <input type="date" id="date" name="date" value="<%= transaction.date.toISOString().split('T')[0] %>"
                    required>

                <div class="form-actions">
                    <a href="/transactions/<%= transaction._id %>" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">Update Transaction</button>
                </div>
            </form>
        </main>

        <%- include('../partials/_footer.ejs') %>
</body>

</html>