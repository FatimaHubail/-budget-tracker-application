<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>Dashboard</title>
</head>
<body>
    <%- include('../partials/_navbar.ejs') %>
    
        <main class="dashboard">
    
            <!-- ===== Currency Toggle ===== -->
            <form method="GET" action="/transactions" class="currency-toggle">
                <input type="hidden" name="category" value="<%= query.category || '' %>">
                <input type="hidden" name="type" value="<%= query.type || '' %>">
                <input type="hidden" name="month" value="<%= query.month || '' %>">
                <input type="hidden" name="search" value="<%= query.search || '' %>">
                <label for="displayCurrency">Show amounts in:</label>
                <select id="displayCurrency" name="displayCurrency" onchange="this.form.submit()">
                    <% currencies.forEach(code => { %>
                        <option value="<%= code %>" <%=displayCurrency===code ? 'selected' : '' %>><%= code %></option>
                    <% }) %>
                </select>
            </form>
    
            <!-- ===== Balance Overview Cards ===== -->
            <section class="balance-cards">
                <div class="card balance">
                    <h3>Balance</h3>
                    <p class="amount">
                        <%= balance.toFixed(decimals) %>
                            <%= displayCurrency %>
                    </p>
                </div>
                <div class="card income">
                    <h3>Income</h3>
                    <p class="amount">
                        <%= income.toFixed(decimals) %>
                            <%= displayCurrency %>
                    </p>
                </div>
                <div class="card expense">
                    <h3>Expenses</h3>
                    <p class="amount">
                        <%= expense.toFixed(decimals) %>
                            <%= displayCurrency %>
                    </p>
                </div>
            </section>
    
            <!-- ===== Budget Status ===== -->
            <section class="budget-section">
                <div class="list-header">
                    <h2>Budget</h2>
                    <a href="/budgets/new" class="btn-add">+ Set Budget</a>
                </div>
    
                <% if (budgets.length===0) { %>
                    <p class="empty-state">No budget limits set yet.</p>
                    <% } else { %>
                        <ul class="budget-list">
                            <% budgets.forEach(budget=> { %>
                                <li class="budget-item <%= budget.exceeded ? 'budget-exceeded' : '' %>">
                                    <div class="budget-label">
                                        <span>
                                            <%= budget.category ? budget.category.charAt(0).toUpperCase() +
                                                budget.category.slice(1) : 'Overall' %>
                                        </span>
                                        <span>
                                            <%= budget.spent.toFixed(decimals) %> / <%= budget.limit.toFixed(decimals) %>
                                                    <%= displayCurrency %>
                                        </span>
                                    </div>
                                    <div class="bar-track">
                                        <div class="bar-fill <%= budget.exceeded ? 'expense-fill' : 'income-fill' %>"
                                            style="width: <%= Math.min(budget.percentage, 100).toFixed(1) %>%;"></div>
                                    </div>
                                    <% if (budget.exceeded) { %>
                                        <p class="budget-warning">⚠️ Exceeded by <%= (budget.spent -
                                                budget.limit).toFixed(decimals) %>
                                                <%= displayCurrency %>
                                        </p>
                                        <% } %>
                                </li>
                                <% }) %>
                        </ul>
                        <% } %>
            </section>
    
            <%- include('../partials/_filterBar.ejs', { query, action: '/transactions' }) %>
    
                <!-- ===== Transaction List ===== -->
                <section class="transaction-list">
                    <div class="list-header">
                        <h2>Transactions</h2>
                        <a href="/transactions/new" class="btn-add">+ Add Transaction</a>
                    </div>
    
                    <% if (transactions.length===0) { %>
                        <p class="empty-state">No transactions found. Try adjusting your filters or add a new transaction.
                        </p>
                        <% } else { %>
                            <table class="transaction-table">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Type</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% transactions.forEach(transaction=> { %>
                                        <tr class="transaction-row">
                                            <td>
                                                <%= transaction.title %>
                                            </td>
                                            <td
                                                class="<%= transaction.type === 'income' ? 'amount-income' : 'amount-expense' %>">
                                                <%= transaction.type %>
                                            </td>
                                            <td>
                                                <a href="/transactions/<%= transaction._id %>" class="btn-details">View
                                                    Details</a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                            <% } %>
                </section>
    
        </main>
    
        <%- include('../partials/_footer.ejs') %>
</body>
</html>